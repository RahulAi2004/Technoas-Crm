# Copy this to server/.env on the server and fill REAL values.
# (server/.env is gitignored — never commit real secrets.)

# Authentication (keep JWT_SECRET private and stable across deployments)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d

# PostgreSQL (decoinks-postgres container, published on host :5436)
DATABASE_URL=postgresql://decoinks:YOUR_DB_PASSWORD@31.97.110.197:5436/decoinks_db

# Qdrant vector DB (host :6333)
QDRANT_URL=http://31.97.110.197:6333
QDRANT_API_KEY=YOUR_QDRANT_API_KEY

# OpenAI (AI Supervisor + translation)
OPENAI_API_KEY=YOUR_OPENAI_KEY

# Optional model overrides
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
